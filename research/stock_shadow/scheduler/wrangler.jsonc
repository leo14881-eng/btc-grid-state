{
  "name": "stock-shadow-scheduler",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-05",
  "triggers": { "crons": ["3,8,13,18,23,28,33,38,43,48,53,58 * * * *"] },
  "durable_objects": {
    "bindings": [{ "name": "STOCK_SCHEDULER", "class_name": "StockScheduler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StockScheduler"] }],
  "observability": { "enabled": true }
}
