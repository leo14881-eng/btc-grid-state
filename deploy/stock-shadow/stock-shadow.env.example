# Operator-owned /etc/stock-shadow/stock-shadow.env; recommended root:stock-shadow 0640.
# This file is a template, not a credential source. Do not commit populated copies.
# Only use already-authorized stock provider keys and the approved Git auth route.
# Never copy a Hunter/crypto environment file or secrets collection into this file.
STOCK_SHADOW_INSTALL_ROOT=/opt/stock-shadow
STOCK_SHADOW_STATE_ROOT=/var/lib/stock-shadow
STOCK_SHADOW_PYTHON=/opt/stock-shadow/venv/bin/python3
TZ=UTC
# Supply only the provider variables the current stock code actually requires:
# APCA_API_KEY_ID=
# APCA_API_SECRET_KEY=
# FMP_API_KEY=
# STOCKFIT_API_KEY=
# Do not set owner, epoch, source commit, run ID or generation here. The runner
# binds them from the isolated current-main checkout on each admitted execution.
# Git authentication is configured separately for this service identity through
# an existing authorized route. No token/password may appear in a remote URL.

# Required for SEC observation requests: operator-approved name/contact string.
# Runtime-only; never commit the real value or include it in logs/test fixtures.
# SEC_USER_AGENT=

# The server runner supplies SEC_TRANSPORT_STATE in its persistent runtime directory.
# Direct invocations need an absolute shared local-filesystem path outside checkouts.
# Missing/unwritable shared state disables SEC requests; never use per-run/temp paths.
# This budget is local to that server, not distributed across hosts. GitHub fallback
# has neither contact nor shared-state configuration and therefore cannot send SEC requests.

# Stock position quote cache candidate: OFF until reviewed and separately enabled.
STOCK_SHADOW_INCREMENTAL_QUOTES=0
# Only monitor jobs accept exact value 1. The runner binds a bounded SQLite cursor
# cache beneath its existing runtime directory (preview/publish are separate).
# Do not set STOCK_SHADOW_QUOTE_CACHE_PATH or STOCK_SHADOW_QUOTE_CACHE_SCOPE here.
# Cache failure falls back to the full three-day query; no cached price is returned.
