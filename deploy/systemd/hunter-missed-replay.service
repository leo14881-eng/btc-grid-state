[Unit]
Description=Hunter missed-replay shadow scheduled job
After=network-online.target
Wants=network-online.target
[Service]
Type=oneshot
WorkingDirectory=/opt/shadow-runner/btc-grid-state
ExecStart=/usr/local/bin/hunter-scheduled-job.sh missed-replay
TimeoutStartSec=900
Nice=10
CPUWeight=20
MemoryMax=768M
StandardOutput=journal
StandardError=journal
